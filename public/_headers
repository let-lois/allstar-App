# The service worker must never be served from cache. A stale sw.js pins an old
# app shell on a rep's phone and there is no way for them to force an update
# from the field.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache

# Build assets are content-hashed, so a given URL's contents can never change —
# which is the textbook case for `immutable` and a one-year max-age. Both are
# deliberately absent here, because that combination caused a real outage.
#
# Pages answers a request for an asset it has not finished propagating with the
# SPA fallback: index.html, content-type text/html, status 200. This rule is what
# decided how long that wrong answer would live. At a year with `immutable`, the
# stylesheet for a whole deployment was served as a brotli-compressed HTML
# document from the edge — status 200, nosniff correctly refusing to apply it,
# every screen unstyled — and a purge-by-URL could not evict it because
# `Vary: accept-encoding` had split it into variants.
#
# Five minutes means the same mistake heals itself before anyone finishes
# reporting it. The cost is near zero: repeat loads never reach this layer at all,
# because the service worker serves assets from Cache Storage, which does not
# consult the HTTP cache. Offline support comes from the worker, not from here.
/assets/*
  Cache-Control: public, max-age=300

# Applied to every page. The app loads nothing from another origin except
# basemap tiles — no CDN, no analytics, no embedded fonts — so the policy can be
# strict rather than aspirational. `connect-src` and `img-src` name the API and
# the tile host explicitly; anything else the app tried to talk to would be a bug
# or a compromise, and either way should fail.
#
# api.maptiler.com appears in both: `img-src` for the tiles themselves, and
# `connect-src` because the service worker fetches them to cache for offline use,
# which is a fetch rather than an image load.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.maptiler.com; font-src 'self'; connect-src 'self' https://allstar-api.josh-af6.workers.dev https://api.maptiler.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(self), microphone=(self), payment=(), usb=()
