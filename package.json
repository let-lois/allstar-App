{
  "name": "allstar-app",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "description": "Allstar — mobile-first field sales (D2D) application",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty",
    "lint": "tsc --noEmit",
    "audit:viewports": "node scripts/audit-viewports.mjs",
    "verify:contrast": "node --import ./scripts/lib/ts-imports.mjs scripts/verify-contrast.mjs",
    "verify:theme": "node scripts/verify-theme.mjs",
    "verify:leadfilter": "node --import ./scripts/lib/ts-imports.mjs scripts/verify-leadfilter.mjs",
    "verify:no-emoji": "node scripts/verify-no-emoji.mjs",
    "verify:badge": "node scripts/verify-badge.mjs",
    "verify:bulk-erase": "node scripts/verify-bulk-erase.mjs",
    "verify:export": "node scripts/verify-export.mjs",
    "verify:leadedit": "node scripts/verify-leadedit.mjs",
    "verify:headings": "node scripts/verify-headings.mjs",
    "verify:viewports": "node scripts/verify-viewports.mjs",
    "verify:onboarding": "node scripts/verify-onboarding.mjs",
    "verify:roster": "node scripts/verify-roster.mjs",
    "verify:leadsheet": "node scripts/verify-leadsheet.mjs",
    "verify:leadlists": "node scripts/verify-leadlists.mjs",
    "verify:legibility": "node scripts/verify-legibility.mjs",
    "verify:offline": "node scripts/verify-offline.mjs",
    "verify:visit-windows": "node scripts/verify-visit-windows.mjs",
    "verify:webview": "node scripts/verify-webview-notice.mjs",
    "verify:demo": "node scripts/verify-demo-freshness.mjs",
    "verify:dnc": "node --import ./scripts/lib/ts-imports.mjs scripts/verify-dnc.mjs",
    "verify:cors-message": "node scripts/verify-cors-message.mjs",
    "verify:mapadd": "node scripts/verify-mapadd.mjs",
    "verify:mapfilters": "node --import ./scripts/lib/ts-imports.mjs scripts/verify-mapfilters.mjs",
    "verify:address": "node --import ./scripts/lib/ts-imports.mjs scripts/verify-address.mjs",
    "verify:mapchrome": "node scripts/verify-mapchrome.mjs",
    "verify:mapzoom": "node scripts/verify-mapzoom.mjs",
    "verify:phonefield": "node scripts/verify-phonefield.mjs",
    "verify:shellios": "node scripts/verify-shell.mjs ios",
    "verify:shellandroid": "node scripts/verify-shell.mjs android",
    "verify:console": "node scripts/verify-console-access.mjs",
    "verify:login": "node scripts/verify-login.mjs",
    "verify:bridge": "node --experimental-strip-types scripts/verify-bridge.mjs",
    "verify:handoff": "node --experimental-strip-types scripts/verify-handoff.mjs",
    "verify:core": "tsc -p packages/core",
    "verify:shell-assets": "node scripts/gen-shell-assets.mjs --check",
    "verify:webview-patch": "node scripts/verify-webview-patch.mjs",
    "verify:store-assets": "node scripts/verify-store-assets.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "verify:api-access": "node scripts/verify-api-access.mjs",
    "verify:backups": "node api/scripts/verify-backup-crypto.mjs",
    "verify:backup-status": "node --import ./scripts/lib/ts-imports.mjs scripts/verify-backup-status.mjs",
    "verify:boot": "node scripts/verify-boot.mjs",
    "verify:geocoders": "node --import ./scripts/lib/ts-imports.mjs scripts/verify-geocoders.mjs",
    "verify:reverse-geocode": "node --import ./scripts/lib/ts-imports.mjs scripts/verify-reverse-geocode.mjs",
    "verify:csv": "node scripts/verify-csv.mjs",
    "verify:merge": "node scripts/verify-crm-merge.mjs",
    "verify:import": "node scripts/verify-import-ui.mjs",
    "verify:lasso": "node scripts/verify-lasso.mjs",
    "verify:route": "node scripts/verify-route.mjs",
    "verify:maptiles": "node scripts/verify-map-tiles.mjs",
    "verify:navigate": "node --import ./scripts/lib/ts-imports.mjs scripts/verify-navigate.mjs",
    "verify:flightline": "node --import ./scripts/lib/ts-imports.mjs scripts/verify-flightline.mjs",
    "verify:classes": "node scripts/verify-classes.mjs",
    "verify:schema": "node scripts/verify-schema-drift.mjs",
    "verify:leaderboard": "node --import ./scripts/lib/ts-imports.mjs scripts/verify-leaderboard.mjs",
    "verify:street": "node scripts/verify-street.mjs",
    "verify:standings": "node scripts/verify-standings.mjs",
    "verify:repdetail": "node scripts/verify-repdetail.mjs",
    "verify:territorydraw": "node scripts/verify-territory-draw.mjs",
    "verify:adminlists": "node scripts/verify-adminlists.mjs",
    "verify:replists": "node scripts/verify-replists.mjs",
    "verify:addresspick": "VITE_GOOGLE_MAPS_KEY=dummy VITE_GOOGLE_MAP_ID=DEMO_MAP_ID vite build --outDir dist-places --emptyOutDir --logLevel warn && node scripts/verify-addresspick.mjs",
    "verify:gmaps-status": "VITE_GOOGLE_MAPS_KEY=dummy VITE_GOOGLE_MAP_ID=DEMO_MAP_ID vite build --outDir dist-gmaps --emptyOutDir --logLevel warn && node scripts/verify-gmaps-status.mjs",
    "verify:lists-e2e": "VITE_API_URL=http://127.0.0.1:8853 vite build --outDir dist-e2e --emptyOutDir --logLevel warn && node scripts/verify-lists-e2e.mjs",
    "verify:phase1-e2e": "VITE_API_URL=http://127.0.0.1:8857 vite build --outDir dist-phase1 --emptyOutDir --logLevel warn && node scripts/verify-phase1-e2e.mjs",
    "verify:streetview": "node --import ./scripts/lib/ts-imports.mjs scripts/verify-streetview.mjs",
    "verify:mapsearch": "node scripts/verify-mapsearch.mjs",
    "verify:newlead": "node scripts/verify-newlead.mjs",
    "verify:googlemap": "node scripts/verify-googlemap.mjs",
    "verify:routelist": "node scripts/verify-routelist.mjs",
    "verify:offlinemaps": "node --import ./scripts/lib/ts-imports.mjs scripts/verify-offline-maps.mjs",
    "verify:firstday": "node scripts/verify-first-day.mjs",
    "leads:sample": "node scripts/make-test-leads.mjs",
    "verify:inspectable": "node scripts/verify-inspectable.mjs",
    "verify:invite": "node scripts/verify-invite.mjs",
    "verify:avatar": "node scripts/verify-avatar.mjs",
    "verify:tour": "node --import ./scripts/lib/ts-imports.mjs scripts/verify-tour.mjs",
    "verify:photos": "node scripts/verify-photos.mjs",
    "verify:geo-parity": "node --import ./scripts/lib/ts-imports.mjs scripts/verify-geo-parity.mjs",
    "verify:day-parity": "node --import ./scripts/lib/ts-imports.mjs scripts/verify-day-parity.mjs",
    "verify:outcome-parity": "node --import ./scripts/lib/ts-imports.mjs scripts/verify-outcome-parity.mjs",
    "verify:persistence": "node scripts/verify-persistence.mjs",
    "verify:pin-precision": "node scripts/verify-pin-precision.mjs",
    "verify:pin-noanswer": "node scripts/verify-pin-noanswer.mjs",
    "verify:erasure-reach": "node scripts/verify-erasure-reach.mjs",
    "verify:charts": "node --import ./scripts/lib/ts-imports.mjs scripts/verify-charts.mjs",
    "verify:basemap": "node --import ./scripts/lib/ts-imports.mjs scripts/verify-basemap.mjs",
    "verify:periods": "node --import ./scripts/lib/ts-imports.mjs scripts/verify-periods.mjs",
    "verify:location": "node scripts/verify-location.mjs",
    "verify:overview": "node scripts/verify-overview.mjs"
  },
  "dependencies": {
    "@allstar/core": "*",
    "@googlemaps/markerclusterer": "^2.6.2",
    "idb": "^8.0.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/google.maps": "^3.65.5",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.49.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
