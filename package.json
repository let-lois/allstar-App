{
  "name": "allstar-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Allstar — mobile-first field sales (D2D) application",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
