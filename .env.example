# Where the app looks for the API.
#
# Build-time, not runtime: Vite inlines it, so changing it means a redeploy.
# Left unset the client falls back to the deployed Worker, which is what a
# production Pages build wants — this file is here for pointing a local dev
# server at `wrangler dev` instead.
#
#   cp .env.example .env.local
VITE_API_URL=http://127.0.0.1:8787
