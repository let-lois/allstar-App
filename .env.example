# Where the app looks for the API.
#
# Build-time, not runtime: Vite inlines it, so changing it means a redeploy.
# Left unset the client falls back to the deployed Worker, which is what a
# production Pages build wants — this file is here for pointing a local dev
# server at `wrangler dev` instead.
#
#   cp .env.example .env.local
VITE_API_URL=http://127.0.0.1:8787

# Basemap imagery. Optional — with no key the map draws its own basemap and
# everything else works unchanged, which is why this is not required to run the
# app. Get a free key at maptiler.com (no card needed) and drop it here.
#
# Build-time, like VITE_API_URL: for the deployed site set it as an environment
# variable on the Cloudflare Pages project, not in this file.
VITE_MAPTILER_KEY=
