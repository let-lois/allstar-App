node_modules
dist
dist-e2e
# TypeScript's incremental build cache — a local artifact, not source.
tsconfig.tsbuildinfo
viewport-audit
*.local
# Local API URL overrides and any other real env values. .env.example is the
# committed template.
.env
.env.*
!.env.example
.DS_Store
.vite

# Database exports. Every customer's addresses, contact names and phone numbers,
# plus password hashes — a backup is the single most sensitive artifact this repo
# can produce, and the one most likely to be committed by accident.
api/backups
backups

# The key those exports are encrypted with. Committing it would put the key and
# the ciphertext in the same place, which is the one arrangement that makes the
# encryption worth nothing. It also must never be LOST: every backup written
# with it becomes unreadable, so it belongs in a password manager and not only
# on this disk.
api/.backup-key
.backup-key

# Worker local state and the generated seed.
# seed.sql is produced by scripts/make-seed.mjs and contains password hashes —
# it is regenerated per environment with that environment's pepper, and must
# never be a committed artifact.
api/.wrangler
api/seed.sql

# Windows shortcut files. These are 2 KB pointers to a path on one person's
# machine, not the file they appear to be — dragging from Explorer produces them
# silently, and a .lnk committed in place of an asset fails in a way that is very
# hard to read (it looks like the file is there and is simply corrupt).
*.lnk

# Weekly build reports.
#
# A deliverable, not source: each is written for a particular week and handed
# over, and committing them would accumulate a binary per week that nothing in
# the app reads. Ignored rather than deleted, so one can sit here while it is
# being sent without showing up as a change to the app.
Allstar-week*.pdf

# Written by api/scripts/stamp-version.mjs on every install, so /api/health can
# report which commit is deployed. Generated rather than committed: a file that
# changes on every install would be dirty in every working tree, and the value
# has to come from the machine doing the build.
api/src/version.ts
