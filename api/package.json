{
  "name": "allstar-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Allstar field sales API — Cloudflare Workers + D1 + R2",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "postinstall": "node scripts/stamp-version.mjs",
    "pretypecheck": "node scripts/stamp-version.mjs",
    "typecheck": "tsc --noEmit",
    "db:schema": "wrangler d1 execute allstar-db --remote --file=./schema.sql",
    "db:schema:local": "wrangler d1 execute allstar-db --local --file=./schema.sql",
    "smoke": "node scripts/smoke.mjs",
    "smoke:all": "node scripts/smoke-all.mjs",
    "smoke:onboarding": "node scripts/smoke-onboarding.mjs",
    "db:schema:flatten": "node -e \"const fs=require('fs');let s=fs.readFileSync('schema.sql','utf8');s=s.replace(/\\\\/\\\\*[\\\\s\\\\S]*?\\\\*\\\\//g,' ').replace(/--[^\\\\n]*/g,' ').replace(/PRAGMA[^;]*;/gi,'');s=s.replace(/\\\\s+/g,' ').trim();fs.writeFileSync('schema.min.sql',s.split(';').map(x=>x.trim()).filter(Boolean).join('; ')+';\\\\n')\"",
    "smoke:import": "node scripts/smoke-import.mjs",
    "verify:directions": "node scripts/verify-directions.mjs",
    "verify:territories": "node scripts/verify-territories.mjs",
    "verify:territory-reps": "node scripts/verify-territory-reps.mjs",
    "verify:geocode": "node scripts/verify-geocode.mjs",
    "smoke:users": "node scripts/smoke-users.mjs",
    "smoke:migrate": "node scripts/smoke-migrate.mjs",
    "smoke:team-model": "node scripts/smoke-team-model.mjs",
    "smoke:observe": "node scripts/smoke-observe.mjs",
    "smoke:cors": "node scripts/smoke-cors.mjs",
    "verify:geocode:fallback": "node scripts/verify-geocode-fallback.mjs",
    "verify:onboarding-status": "node scripts/verify-onboarding-status.mjs",
    "smoke:photos": "node scripts/smoke-photos.mjs",
    "smoke:backup": "node scripts/smoke-backup.mjs",
    "smoke:deadkey": "node scripts/smoke-geocode-dead-key.mjs",
    "smoke:lists": "node scripts/smoke-lists.mjs",
    "smoke:territory-reps": "node scripts/smoke-territory-reps.mjs",
    "smoke:onboarding-schema": "node scripts/smoke-onboarding-schema.mjs",
    "smoke:onboarding-flow": "node scripts/smoke-onboarding-flow.mjs",
    "smoke:mail": "node scripts/smoke-mail.mjs",
    "smoke:onboarding-steps": "node scripts/smoke-onboarding-steps.mjs",
    "smoke:export": "node scripts/smoke-export.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:open": "node scripts/backup-open.mjs",
    "backup:list": "node scripts/backup-open.mjs --list",
    "verify:restore": "node scripts/verify-restore.mjs",
    "smoke:integrations": "node scripts/smoke-integrations.mjs",
    "smoke:crm-push": "node scripts/smoke-crm-push.mjs",
    "smoke:crm-inbound": "node scripts/smoke-crm-inbound.mjs",
    "smoke:erase": "node scripts/smoke-erase.mjs",
    "smoke:stale": "node scripts/smoke-stale.mjs",
    "smoke:money": "node scripts/smoke-closed-value.mjs",
    "db:rebuild-closed": "node scripts/rebuild-closed-value.mjs",
    "smoke:daybreak": "node scripts/smoke-daybreak.mjs",
    "db:rebuild-stats": "node scripts/rebuild-daily-stats.mjs",
    "smoke:tiles": "node scripts/smoke-tiles.mjs",
    "addresses:build": "node scripts/addresses-build.mjs",
    "national:build": "node scripts/national-build.mjs",
    "verify:tiger": "node scripts/verify-tiger.mjs",
    "verify:addresses": "node scripts/verify-addresses.mjs",
    "smoke:territory-leads": "node scripts/smoke-territory-leads.mjs",
    "smoke:lead-edit": "node scripts/smoke-lead-edit.mjs",
    "smoke:quote-sent": "node scripts/smoke-quote-sent.mjs",
    "smoke:account-delete": "node scripts/smoke-account-delete.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "aws4fetch": "^1.0.20",
    "fflate": "^0.8.3",
    "hyparquet": "^1.31.2",
    "hyparquet-compressors": "^1.1.2",
    "shapefile": "^0.6.6",
    "typescript": "^5.6.3",
    "wrangler": "^3.99.0"
  }
}
