{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "image": "latest"
      },
      "ios": {
        "image": "latest"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "ios": {
        "image": "latest",
        "simulator": true
      },
      "channel": "preview"
    },
    "preview-device": {
      "extends": "preview",
      "ios": {
        "image": "latest",
        "simulator": false
      }
    },
    "testflight-preview": {
      "distribution": "store",
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": true,
      "ios": {
        "image": "latest"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "image": "latest",
        "buildType": "app-bundle"
      },
      "ios": {
        "image": "latest"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6813645551"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "testflight-preview": {
      "ios": {
        "ascAppId": "6813645551"
      }
    }
  }
}
