# Android release signing and Play publishing. The upload keystore lives in
# EAS's credential store and the Play service-account key in EAS submit
# credentials — neither belongs in the repository, ever.
*.keystore
credentials.json
*service-account*.json
google-play-*.json
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Metro/EAS build artefacts
/dist/
/.expo/
