# Build-time configuration for the native app.
#
#   cp .env.example .env.local
#
# Metro inlines every `EXPO_PUBLIC_*` name, the same way Vite inlines the
# `VITE_*` names for the web app — see the repo root's .env.example and the
# `define` block in ../../vite.config.ts.

# The public web address of the app. REQUIRED for any build a rep will use.
#
# Every team member badge carries a QR code, and it is built from
# `window.location.origin` unless this is set. Inside the DOM shell that origin
# is the webview's local one, so the code would be one no homeowner's camera
# can open — and nothing on screen would look wrong. Set it to the address the
# web app is served from in production.
EXPO_PUBLIC_ORIGIN=

# Where the app looks for the API. Unset, the client falls back to the deployed
# Worker, which is what a shipping build wants.
EXPO_PUBLIC_API_URL=

# Basemap imagery and the Google basemap. Optional and all-or-nothing
# respectively, exactly as on the web — see the root .env.example.
EXPO_PUBLIC_MAPTILER_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
EXPO_PUBLIC_GOOGLE_MAP_ID=
