{
  "expo": {
    "name": "All-Star",
    "slug": "all-star-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "allstar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.allstarhomesolutions.allstar",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "All-Star uses your location to order your route from where you are standing and to place a lead on the house in front of you.",
        "NSCameraUsageDescription": "All-Star uses the camera so you can photograph a property from the door and attach it to the lead you are recording.",
        "NSPhotoLibraryUsageDescription": "All-Star lets you attach a photo you already took to a lead or to your team member profile.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07B3CA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.allstarhomesolutions.allstar",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "backgroundColor": "#f0f2f7",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0d1320"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "let-lois",
    "extra": {
      "eas": {
        "projectId": "497739ce-76e6-420a-b80e-308126e25f35"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/497739ce-76e6-420a-b80e-308126e25f35"
    }
  }
}
