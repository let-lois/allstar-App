{
  "expo": {
    "name": "All-Star",
    "slug": "all-star-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "allstar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.allstarhomesolutions.allstar",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "All-Star uses your location to order your route from where you are standing and to place a lead on the house in front of you.",
        "NSCameraUsageDescription": "All-Star uses the camera so you can photograph a property from the door and attach it to the lead you are recording.",
        "NSPhotoLibraryUsageDescription": "All-Star lets you attach a photo you already took to a lead or to your team member profile.",
        "NSPhotoLibraryAddUsageDescription": "All-Star saves your team badge to your photos when you choose Save Image.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "All-Star uses the microphone when you tap the mic in a note, so you can dictate what happened at the door instead of typing it.",
        "NSSpeechRecognitionUsageDescription": "All-Star turns what you dictate into note text. Nothing is saved until you review the note and save it yourself."
      },
